{
  "ServiceComponents": {
    "RabbitConnectionOptions": {
      "EndpointUri": "amqp://guest:guest@localhost:5672/",
      "ClientName": "example-app",
      "AutomaticRecoveryEnabled": true,
      "HandshakeContinuationTimeoutInSeconds": 120000,
      "RequestedHeartbeatInSeconds": 60000,
      "RequestedChannelMaxInSeconds": 2048,
      "NetworkRecoveryIntervalInSeconds": 5000,
      "Ssl": false,
      "VirtualHost": "/",
      "ContinuationTimeout": true
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  }
}

